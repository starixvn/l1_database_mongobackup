FROM hub.lumigame.com/ldb/mongotools:1.0.1
RUN apt-get update \
 && apt-get install --no-install-recommends -y \
      git gpg gpg-agent \
      curl ca-certificates \
      ftp \
 && rm -rf /var/lib/apt/lists/*
ENV GNUPGHOME /gnupg
RUN mkdir ${GNUPGHOME} -p \
 && git config --global gc.reflogexpireunreachable "all"
WORKDIR /root
COPY ./dr-backup/*.sh ./
COPY ./dr-backup/dbs/ /dbs/
VOLUME /drbackup /gnupg
ENTRYPOINT ["./docker-entrypoint.sh"]
CMD ["./DRBackup.sh", "-h"]
 